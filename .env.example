# ---------------------------------------------------------------------------
# Work IQ MCP (サインインした本人の委任トークンで呼ぶ)
# ---------------------------------------------------------------------------
# アプリ登録の「アプリケーション (クライアント) ID」(README の「1. アプリ登録」)
WORKIQ_CLIENT_ID=
# 同じアプリ登録の「証明書とシークレット」で発行したクライアント シークレットの値
WORKIQ_CLIENT_SECRET=
# 単一テナント運用なら自テナントの ID、マルチテナントなら organizations のまま
WORKIQ_AUTHORITY=https://login.microsoftonline.com/organizations
# アプリ登録の「Web」プラットフォームに登録したリダイレクト URI と完全一致させる
REDIRECT_URI=http://localhost:8000/auth/callback

# セッション cookie の署名鍵。未設定だと起動ごとにランダム生成され、
# 再起動でサインイン状態が切れる。
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# 指定しないと Work IQ は時刻を UTC で返す
WORKIQ_TIME_ZONE=Asia/Tokyo

# SharePoint のフォルダー URL。設定すると画面に「② 決めた資料だけ」が出る。
# 空なら ① だけ (利用者が見られる範囲すべてが対象)。
#   例: https://contoso.sharepoint.com/sites/Sales/Shared%20Documents/提案書
WORKIQ_FOLDER_URL=

# ---------------------------------------------------------------------------
# エージェント側のモデル
# ---------------------------------------------------------------------------
# 例: https://<resource>.openai.azure.com/ または
#     https://<resource>.services.ai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
